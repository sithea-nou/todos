# Database (optional — defaults to ./todos.db)
# DATABASE_URL=sqlite+aiosqlite:///./todos.db

# Debug logging (optional — set to true to see LLM and database debug logs)
# DEBUG_LOGGING=false

# Chatbot model and API keys
# See docs/README.md for provider-specific setup

# Anthropic Claude (default)
CHAT_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=sk-ant-...

# Uncomment for OpenAI
# CHAT_MODEL=gpt-4o
# OPENAI_API_KEY=sk-...

# Uncomment for Ollama (running locally)
# CHAT_MODEL=ollama/llama3.1
# CHAT_API_BASE=http://host.docker.internal:11434  (Mac/Windows Docker)
# CHAT_API_BASE=http://localhost:11434            (local/Linux)

# Uncomment for LM Studio or any OpenAI-compatible server
# CHAT_MODEL=openai/my-model
# CHAT_API_BASE=http://localhost:1234/v1
